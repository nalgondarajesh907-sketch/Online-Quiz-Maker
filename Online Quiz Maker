/* =========================================================
   STATE
========================================================= */

let quizzes =
JSON.parse(
localStorage.getItem("quizlyQuizzes")
) || defaultQuizzes;


let currentQuiz = null;

let currentQuestion = 0;

let selectedAnswers = [];

let questionNumber = 0;


/* =========================================================
   SAVE QUIZZES
========================================================= */

function saveQuizzes(){

    localStorage.setItem(
        "quizlyQuizzes",
        JSON.stringify(quizzes)
    );

}


/* =========================================================
   HOME
========================================================= */

function showHome(){

    hideAllPages();

    document
    .getElementById("homePage")
    .style.display="block";

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


function hideAllPages(){

    document
    .getElementById("homePage")
    .style.display="none";

    document
    .getElementById("creatorPage")
    .classList.remove("active");

    document
    .getElementById("quizPage")
    .classList.remove("active");

    document
    .getElementById("resultPage")
    .classList.remove("active");

    document
    .getElementById("dashboardPage")
    .classList.remove("active");

}


/* =========================================================
   RENDER QUIZZES
========================================================= */

function renderQuizzes(){

    const grid =
    document.getElementById("quizGrid");

    grid.innerHTML="";


    quizzes.forEach(quiz=>{

        const card =
        document.createElement("div");

        card.className="quiz-card";


        card.innerHTML=`

            <div class="quiz-cover">
                ${quiz.icon || "📝"}
            </div>

            <span class="quiz-category">
                ${quiz.category.toUpperCase()}
            </span>

            <h3>
                ${quiz.title}
            </h3>

            <p>
                ${quiz.description || "Test your knowledge."}
            </p>

            <div class="quiz-meta">

                <span>
                    ${quiz.questions.length} Questions
                </span>

                <span>
                    ⭐ 4.8
                </span>

            </div>
        `;


        card.onclick=()=>{

            startQuiz(quiz.id);

        };


        grid.appendChild(card);

    });

}


/* =========================================================
   CREATE QUIZ
========================================================= */

function openCreator(){

    hideAllPages();

    document
    .getElementById("creatorPage")
    .classList.add("active");

    document
    .getElementById("questionContainer")
    .innerHTML="";

    questionNumber=0;

    addQuestion();

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =========================================================
   ADD QUESTION
========================================================= */

function addQuestion(){

    questionNumber++;


    const container =
    document.getElementById(
        "questionContainer"
    );


    const div =
    document.createElement("div");


    div.className="question-item";


    div.innerHTML=`

        <div class="question-header">

            <b>
                Question ${questionNumber}
            </b>

            <button
                class="btn btn-danger"
                onclick="this.parentElement.parentElement.remove()"
            >
                Remove
            </button>

        </div>


        <div class="form-group">

            <label>
                Question
            </label>

            <input
                class="new-question"
                placeholder="Enter your question..."
            >

        </div>


        <label>
            Options
        </label>


        <div class="option-builder">

            <input
                type="radio"
                name="correct-${questionNumber}"
                value="0"
                checked
            >

            <input
                class="new-option"
                placeholder="Option A"
            >

        </div>


        <div class="option-builder">

            <input
                type="radio"
                name="correct-${questionNumber}"
                value="1"
            >

            <input
                class="new-option"
                placeholder="Option B"
            >

        </div>


        <div class="option-builder">

            <input
                type="radio"
                name="correct-${questionNumber}"
                value="2"
            >

            <input
                class="new-option"
                placeholder="Option C"
            >

        </div>


        <div class="option-builder">

            <input
                type="radio"
                name="correct-${questionNumber}"
                value="3"
            >

            <input
                class="new-option"
                placeholder="Option D"
            >

        </div>

    `;


    container.appendChild(div);

}


/* =========================================================
   PUBLISH QUIZ
========================================================= */

function publishQuiz(){

    const title =
    document
    .getElementById("quizTitle")
    .value
    .trim();


    const category =
    document
    .getElementById("quizCategory")
    .value;


    const description =
    document
    .getElementById("quizDescription")
    .value
    .trim();


    if(!title){

        showToast(
            "Please enter a quiz title."
        );

        return;

    }


    const items =
    document.querySelectorAll(
        ".question-item"
    );


    if(items.length===0){

        showToast(
            "Please add at least one question."
        );

        return;

    }


    const questions=[];


    for(
        let i=0;
        i<items.length;
        i++
    ){

        const item=items[i];


        const question =
        item
        .querySelector(".new-question")
        .value
        .trim();


        const options =
        [
            ...item
            .querySelectorAll(".new-option")
        ]
        .map(input=>input.value.trim());


        const correct =
        Number(
            item
            .querySelector(
                "input[type=radio]:checked"
            )
            .value
        );


        if(
            !question ||
            options.some(
                option=>!option
            )
        ){

            showToast(
                "Please complete all questions and options."
            );

            return;

        }


        questions.push({

            question,

            options,

            answer:correct

        });

    }


    const quiz={

        id:Date.now(),

        title,

        category,

        icon:"📝",

        description,

        questions

    };


    quizzes.push(quiz);


    saveQuizzes();


    showToast(
        "Quiz published successfully! 🎉"
    );


    setTimeout(()=>{

        startQuiz(quiz.id);

    },700);

}


/* =========================================================
   START QUIZ
========================================================= */

function startQuiz(id){

    currentQuiz =
    quizzes.find(
        quiz=>quiz.id===id
    );


    if(!currentQuiz){

        return;

    }


    currentQuestion=0;


    selectedAnswers =
    new Array(
        currentQuiz.questions.length
    ).fill(null);


    hideAllPages();


    document
    .getElementById("quizPage")
    .classList.add("active");


    document
    .getElementById("playTitle")
    .textContent=currentQuiz.title;


    document
    .getElementById("playCategory")
    .textContent=
    currentQuiz.category.toUpperCase();


    showQuestion();


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =========================================================
   SHOW QUESTION
========================================================= */

function showQuestion(){

    const question =
    currentQuiz
    .questions[currentQuestion];


    const total =
    currentQuiz.questions.length;


    document
    .getElementById("questionText")
    .textContent=
    question.question;


    document
    .getElementById("questionLabel")
    .textContent=
    `QUESTION ${String(currentQuestion+1).padStart(2,"0")}`;


    document
    .getElementById("questionCounter")
    .textContent=
    `Question ${currentQuestion+1} / ${total}`;


    document
    .getElementById("playProgress")
    .style.width=
    `${((currentQuestion+1)/total)*100}%`;


    const container =
    document
    .getElementById("answerContainer");


    container.innerHTML="";


    question.options.forEach(
        (option,index)=>{

            const label =
            document.createElement("label");


            label.className=
            "question-option";


            if(
                selectedAnswers[currentQuestion]
                ===index
            ){

                label.classList.add(
                    "selected"
                );

            }


            label.innerHTML=`

                <input
                    type="radio"
                    name="answer"
                    value="${index}"
                    ${
                        selectedAnswers[currentQuestion]
                        ===index
                        ?"checked":""
                    }
                >

                <span>
                    ${option}
                </span>

            `;


            label.onclick=()=>{

                selectedAnswers[
                    currentQuestion
                ]=index;


                showQuestion();

            };


            container.appendChild(label);

        }
    );


    document
    .getElementById("previousBtn")
    .disabled=
    currentQuestion===0;


    document
    .getElementById("nextBtn")
    .textContent=
    currentQuestion===
    total-1
    ?
    "Finish Quiz ✓"
    :
    "Next →";

}


/* =========================================================
   NEXT QUESTION
========================================================= */

function nextQuestion(){

    if(
        selectedAnswers[currentQuestion]
        ===null
    ){

        showToast(
            "Please select an answer."
        );

        return;

    }


    if(
        currentQuestion <
        currentQuiz.questions.length-1
    ){

        currentQuestion++;

        showQuestion();

    }

    else{

        finishQuiz();

    }

}


/* =========================================================
   PREVIOUS QUESTION
========================================================= */

function previousQuestion(){

    if(currentQuestion>0){

        currentQuestion--;

        showQuestion();

    }

}


/* =========================================================
   FINISH QUIZ
========================================================= */

function finishQuiz(){

    let correct=0;


    currentQuiz.questions.forEach(
        (question,index)=>{

            if(
                selectedAnswers[index]
                ===question.answer
            ){

                correct++;

            }

        }
    );


    const total =
    currentQuiz.questions.length;


    const percentage =
    Math.round(
        (correct/total)*100
    );


    const results =
    JSON.parse(
        localStorage.getItem(
            "quizlyResults"
        )
    ) || [];


    results.push({

        quiz:
        currentQuiz.title,

        correct,

        total,

        percentage,

        date:
        new Date()
        .toLocaleString()

    });


    localStorage.setItem(
        "quizlyResults",
        JSON.stringify(results)
    );


    document
    .getElementById("finalScore")
    .textContent=
    percentage+"%";


    document
    .getElementById("correctCount")
    .textContent=
    correct;


    document
    .getElementById("wrongCount")
    .textContent=
    total-correct;


    document
    .getElementById("totalCount")
    .textContent=
    total;


    let heading;


    if(percentage>=80){

        heading="Excellent Work! 🏆";

    }

    else if(percentage>=60){

        heading="Good Job! 👏";

    }

    else{

        heading="Keep Practicing! 💪";

    }


    document
    .getElementById("resultHeading")
    .textContent=
    heading;


    document
    .getElementById("resultMessage")
    .textContent=
    `You scored ${correct} out of ${total} in ${currentQuiz.title}.`;


    hideAllPages();


    document
    .getElementById("resultPage")
    .classList.add("active");


    updateDashboard();


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

}


/* =========================================================
   DASHBOARD
========================================================= */

function openDashboard(){

    hideAllPages();


    document
