}


function updateDashboard(){

    const results =
    JSON.parse(
        localStorage.getItem(
            "quizlyResults"
        )
    ) || [];


    const created =
    quizzes.length-
    defaultQuizzes.length;


    const correct =
    results.reduce(
        (sum,result)=>
        sum+result.correct,
        0
    );


    const average =
    results.length
    ?
    Math.round(
        results.reduce(
            (sum,result)=>
            sum+result.percentage,
            0
        )/results.length
    )
    :
    0;


    document
    .getElementById("dashTaken")
    .textContent=
    results.length;


    document
    .getElementById("dashAverage")
    .textContent=
    average+"%";


    document
    .getElementById("dashCorrect")
    .textContent=
    correct;


    document
    .getElementById("dashCreated")
    .textContent=
    created;


    const activity =
    document
    .getElementById("activityList");


    if(!results.length){

        activity.innerHTML=`

        <p style="
        color:var(--muted);
        font-size:12px;
        ">
        No activity yet.
        Take a quiz to get started!
        </p>

        `;

        return;

    }


    activity.innerHTML="";


    results
    .slice(-5)
    .reverse()
    .forEach(result=>{

        const div =
        document.createElement("div");


        div.className="activity";


        div.innerHTML=`

            <div class="activity-icon">
                🏆
            </div>

            <div>

                <b style="font-size:12px">
                    ${result.quiz}
                </b>

                <p style="
                font-size:10px;
                color:var(--muted);
                ">
                    Score: ${result.percentage}%
                    · ${result.date}
                </p>

            </div>

        `;


        activity.appendChild(div);

    });

}


/* =========================================================
   LOGIN
========================================================= */

function openLogin(){

    closeModals();

    document
    .getElementById("loginModal")
    .classList.add("show");

}


function loginUser(){

    const email =
    document
    .getElementById("loginEmail")
    .value;


    const password =
    document
    .getElementById("loginPassword")
    .value;


    if(!email || !password){

        showToast(
            "Please enter email and password."
        );

        return;

    }


    localStorage.setItem(
        "quizlyUser",
        email
    );


    closeModals();


    showToast(
        "Login successful! 👋"
    );

}


/* =========================================================
   REGISTER
========================================================= */

function openRegister(){

    closeModals();

    document
    .getElementById("registerModal")
    .classList.add("show");

}


function registerUser(){

    const name =
    document
    .getElementById("registerName")
    .value;


    const email =
    document
    .getElementById("registerEmail")
    .value;


    const password =
    document
    .getElementById("registerPassword")
    .value;


    if(
        !name ||
        !email ||
        !password
    ){

        showToast(
            "Please complete all fields."
        );

        return;

    }


    localStorage.setItem(
        "quizlyUser",
        JSON.stringify({
            name,
            email
        })
    );


    closeModals();


    showToast(
        `Welcome to Quizly, ${name}! 🎉`
    );

}


/* =========================================================
   MODALS
========================================================= */

function closeModals(){

    document
    .querySelectorAll(".modal")
    .forEach(modal=>{

        modal.classList.remove(
            "show"
        );

    });

}


/* =========================================================
   DARK MODE
========================================================= */

function toggleDarkMode(){

    document
    .body
    .classList
    .toggle("dark");


    localStorage.setItem(
        "quizlyDark",
        document
        .body
        .classList
        .contains("dark")
    );

}


/* =========================================================
   CLEAR DATA
========================================================= */

function clearData(){

    if(
        confirm(
            "Reset quiz results and custom quizzes?"
        )
    ){

        localStorage.removeItem(
            "quizlyResults"
        );

        localStorage.removeItem(
            "quizlyQuizzes"
        );


        quizzes=[
            ...defaultQuizzes
        ];


        updateDashboard();

        renderQuizzes();


        showToast(
            "Data reset successfully."
        );

    }

}


/* =========================================================
   TOAST
========================================================= */

function showToast(message){

    const toast =
    document.getElementById(
        "toast"
    );


    toast.textContent=message;


    toast.classList.add(
        "show"
    );


    setTimeout(()=>{

        toast.classList.remove(
            "show"
        );

    },2500);

}


/* =========================================================
   NAVIGATION
========================================================= */

function scrollToPopular(){

    showHome();


    setTimeout(()=>{

        document
        .getElementById("popular")
        .scrollIntoView({
            behavior:"smooth"
        });

    },100);

}


/* =========================================================
   INITIALIZATION
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    ()=>{

        renderQuizzes();


        if(
            localStorage.getItem(
                "quizlyDark"
            )==="true"
        ){

            document
            .body
            .classList
            .add("dark");

        }

        showHome();

    }
);


/* =========================================================
   CLOSE MODAL WHEN CLICKING OUTSIDE
========================================================= */

document.addEventListener(
    "click",
    event=>{

        if(
            event.target.classList
            .contains("modal")
        ){

            closeModals();

        }

    }
);

</script>

