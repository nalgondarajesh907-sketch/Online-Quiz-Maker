<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Quizly - Online Quiz Maker</title>

<style>

/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

    background:#f5f7fb;
    color:#172033;

    transition:.3s;
}

button,
input,
textarea,
select{
    font-family:inherit;
}

button{
    cursor:pointer;
}

a{
    text-decoration:none;
    color:inherit;
}


/* =========================================================
   DARK MODE
========================================================= */

body.dark{
    background:#10131c;
    color:#f4f6fb;
}

body.dark .navbar,
body.dark .card,
body.dark .modal-box,
body.dark .quiz-box,
body.dark .stat-card{
    background:#181c27;
    border-color:#292e3c;
}

body.dark input,
body.dark textarea,
body.dark select{
    background:#11151e;
    color:white;
    border-color:#343a49;
}

body.dark .hero{
    background:
    radial-gradient(circle at 80% 20%,#30215e,transparent 35%),
    #151927;
}

body.dark .feature-card,
body.dark .quiz-card{
    background:#181c27;
    border-color:#292e3c;
}

body.dark .question-option{
    background:#202532;
    border-color:#343a49;
}


/* =========================================================
   VARIABLES
========================================================= */

:root{

    --primary:#6847f5;
    --primary-dark:#5133d4;

    --secondary:#8f6cff;

    --success:#16a36b;
    --danger:#e5485d;
    --warning:#f3a735;

    --text:#172033;
    --muted:#778095;

    --border:#e4e8f0;

    --white:#ffffff;

    --shadow:
    0 15px 45px rgba(31,41,61,.08);

}


/* =========================================================
   NAVBAR
========================================================= */

.navbar{

    position:sticky;
    top:0;

    z-index:100;

    height:72px;

    background:white;

    border-bottom:1px solid var(--border);

    display:flex;
    align-items:center;

    justify-content:space-between;

    padding:0 6%;

    backdrop-filter:blur(20px);
}

.logo{

    display:flex;
    align-items:center;

    gap:10px;

    font-size:22px;

    font-weight:900;

    color:var(--primary);
}

.logo-icon{

    width:38px;
    height:38px;

    display:grid;
    place-items:center;

    border-radius:11px;

    color:white;

    background:
    linear-gradient(
        135deg,
        var(--primary),
        var(--secondary)
    );

    box-shadow:
    0 7px 20px rgba(104,71,245,.25);
}

.nav-links{

    display:flex;

    gap:30px;

    list-style:none;
}

.nav-links a{

    font-size:13px;

    font-weight:700;

    color:#70798c;

    transition:.2s;
}

.nav-links a:hover{

    color:var(--primary);
}

.nav-actions{

    display:flex;

    align-items:center;

    gap:10px;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn{

    border:none;

    padding:11px 18px;

    border-radius:9px;

    font-size:13px;

    font-weight:800;

    transition:.25s;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:7px;
}

.btn-primary{

    background:
    linear-gradient(
        135deg,
        var(--primary),
        var(--secondary)
    );

    color:white;

    box-shadow:
    0 8px 20px rgba(104,71,245,.2);
}

.btn-primary:hover{

    transform:translateY(-2px);

    box-shadow:
    0 12px 25px rgba(104,71,245,.3);
}

.btn-outline{

    background:white;

    border:1px solid var(--border);

    color:#4e586d;
}

.btn-outline:hover{

    border-color:var(--primary);

    color:var(--primary);
}

.btn-danger{

    background:#fff0f2;

    color:var(--danger);
}

.btn-success{

    background:#e8faf2;

    color:var(--success);
}


/* =========================================================
   HERO
========================================================= */

.hero{

    min-height:650px;

    display:flex;

    align-items:center;

    background:

    radial-gradient(
        circle at 85% 20%,
        #e8e0ff,
        transparent 32%
    ),

    linear-gradient(
        135deg,
        #faf9ff,
        #f0edff
    );

    overflow:hidden;
}

.hero-container{

    width:88%;

    max-width:1200px;

    margin:auto;

    display:grid;

    grid-template-columns:
    1.05fr
    .95fr;

    gap:70px;

    align-items:center;
}

.badge{

    display:inline-flex;

    padding:7px 13px;

    border-radius:50px;

    background:#eeeaff;

    color:var(--primary);

    font-size:10px;

    font-weight:900;

    letter-spacing:.7px;
}

.hero h1{

    font-size:62px;

    line-height:1.04;

    letter-spacing:-3px;

    margin:20px 0;
}

.hero h1 span{

    color:var(--primary);
}

.hero p{

    max-width:580px;

    color:var(--muted);

    font-size:16px;

    line-height:1.8;
}

.hero-buttons{

    display:flex;

    gap:12px;

    margin-top:30px;
}


/* =========================================================
   HERO QUIZ PREVIEW
========================================================= */

.preview{

    background:white;

    padding:18px;

    border-radius:18px;

    box-shadow:
    0 30px 80px rgba(53,43,105,.16);

    transform:rotate(1.5deg);

    animation:float 4s ease-in-out infinite;
}

@keyframes float{

    0%,100%{
        transform:translateY(0) rotate(1.5deg);
    }

    50%{
        transform:translateY(-10px) rotate(1.5deg);
    }
}

.preview-inner{

    border:1px solid #edf0f5;

    border-radius:12px;

    padding:25px;
}

.preview-top{

    display:flex;

    justify-content:space-between;

    color:#7b8497;

    font-size:10px;

    font-weight:800;
}

.progress{

    height:7px;

    background:#eceef3;

    border-radius:20px;

    margin:14px 0 25px;

    overflow:hidden;
}

.progress span{

    display:block;

    height:100%;

    width:65%;

    background:
    linear-gradient(
        90deg,
        var(--primary),
        var(--secondary)
    );

    border-radius:20px;
}

.preview small{

    color:var(--primary);

    font-size:9px;

    font-weight:900;
}

.preview h3{

    font-size:20px;

    margin:10px 0 20px;
}

.preview-option{

    padding:13px;

    border:1px solid #e2e6ee;

    border-radius:9px;

    margin:9px 0;

    font-size:12px;
}

.preview-option.active{

    border-color:var(--primary);

    background:#f0edff;

    color:var(--primary);

    font-weight:800;
}


/* =========================================================
   SECTIONS
========================================================= */

.section{

    width:88%;

    max-width:1200px;

    margin:auto;

    padding:75px 0;
}

.section-title{

    text-align:center;

    margin-bottom:40px;
}

.section-title small{

    color:var(--primary);

    font-weight:900;

    font-size:11px;

    letter-spacing:1px;
}

.section-title h2{

    font-size:34px;

    margin:7px 0;
}

.section-title p{

    color:var(--muted);

    font-size:13px;
}


/* =========================================================
   FEATURES
========================================================= */

.features{

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.feature-card{

    background:white;

    border:1px solid var(--border);

    padding:28px;

    border-radius:15px;

    transition:.25s;

    box-shadow:var(--shadow);
}

.feature-card:hover{

    transform:translateY(-6px);
}

.feature-icon{

    width:55px;

    height:55px;

    display:grid;

    place-items:center;

    border-radius:14px;

    font-size:25px;

    background:#eeeaff;

    margin-bottom:20px;
}

.feature-card h3{

    margin-bottom:8px;

    font-size:17px;
}

.feature-card p{

    color:var(--muted);

    font-size:12px;

    line-height:1.7;
}


/* =========================================================
   QUIZ CARDS
========================================================= */

.quiz-grid{

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.quiz-card{

    background:white;

    border:1px solid var(--border);

    border-radius:15px;

    padding:18px;

    transition:.25s;

    cursor:pointer;

    box-shadow:var(--shadow);
}

.quiz-card:hover{

    transform:translateY(-5px);

    box-shadow:
    0 20px 45px rgba(31,41,61,.12);
}

.quiz-cover{

    height:140px;

    display:grid;

    place-items:center;

    border-radius:12px;

    font-size:48px;

    margin-bottom:18px;

    background:
    linear-gradient(
        135deg,
        #ece7ff,
        #f5f2ff
    );
}

.quiz-category{

    font-size:9px;

    color:var(--primary);

    font-weight:900;

    letter-spacing:.8px;
}

.quiz-card h3{

    font-size:17px;

    margin:7px 0;
}

.quiz-card p{

    color:var(--muted);

    font-size:11px;

    margin-bottom:12px;
}

.quiz-meta{

    display:flex;

    justify-content:space-between;

    color:#737c8e;

    font-size:10px;

    font-weight:700;
}


/* =========================================================
   STATS
========================================================= */

.stats{

    background:#1c2130;

    color:white;

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    padding:45px 8%;

    text-align:center;
}

.stat h3{

    font-size:31px;
}

.stat p{

    color:#aeb4c1;

    font-size:11px;
}


/* =========================================================
   APP CONTAINER
========================================================= */

.app{

    display:none;

    min-height:calc(100vh - 72px);

    padding:50px 6%;
}

.app.active{

    display:block;
}

.app-header{

    max-width:1100px;

    margin:auto;

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:30px;
}

.app-header h1{

    font-size:32px;
}

.app-header p{

    color:var(--muted);

    font-size:13px;
}


/* =========================================================
   DASHBOARD
========================================================= */

.dashboard-grid{

    max-width:1100px;

    margin:auto;

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:16px;

    margin-bottom:25px;
}

.stat-card{

    background:white;

    border:1px solid var(--border);

    border-radius:13px;

    padding:20px;

    box-shadow:var(--shadow);
}

.stat-card small{

    color:var(--muted);

    font-size:10px;

    font-weight:800;
}

.stat-card h2{

    margin-top:7px;

    font-size:27px;
}

.dashboard-main{

    max-width:1100px;

    margin:auto;

    display:grid;

    grid-template-columns:
    1.4fr .8fr;

    gap:20px;
}

.card{

    background:white;

    border:1px solid var(--border);

    border-radius:15px;

    padding:25px;

    box-shadow:var(--shadow);
}

.card h2{

    font-size:18px;

    margin-bottom:20px;
}

.activity{

    display:flex;

    align-items:center;

    gap:12px;

    padding:13px 0;

    border-bottom:1px solid #edf0f4;
}

.activity-icon{

    width:35px;

    height:35px;

    border-radius:9px;

    display:grid;

    place-items:center;

    background:#eeeaff;
}


/* =========================================================
   CREATE QUIZ
========================================================= */

.creator{

    max-width:900px;

    margin:auto;
}

.creator-top{

    display:flex;

    justify-content:space-between;

    align-items:end;

    margin-bottom:25px;
}

.creator-top h1{

    font-size:32px;

    margin-top:8px;
}

.form-group{

    margin-bottom:17px;
}

.form-group label{

    display:block;

    font-size:11px;

    font-weight:900;

    margin-bottom:7px;
}

input,
textarea,
select{

    width:100%;

    padding:12px;

    border:1px solid var(--border);

    border-radius:9px;

    outline:none;

    background:white;

    color:var(--text);

    transition:.2s;
}

input:focus,
textarea:focus,
select:focus{

    border-color:var(--primary);

    box-shadow:
    0 0 0 3px rgba(104,71,245,.08);
}

.question-builder{

    margin-top:30px;
}

.question-item{

    background:#fafbfe;

    border:1px solid var(--border);

    padding:20px;

    border-radius:12px;

    margin-bottom:15px;
}

body.dark .question-item{

    background:#131722;
}

.question-header{

    display:flex;

    justify-content:space-between;

    margin-bottom:15px;
}

.question-header b{

    font-size:12px;
}

.option-builder{

    display:grid;

    grid-template-columns:
    25px 1fr;

    gap:8px;

    align-items:center;

    margin-top:8px;
}

.option-builder input[type=radio]{

    width:auto;
}

.builder-actions{

    display:flex;

    justify-content:space-between;

    margin-top:25px;
}


/* =========================================================
   QUIZ PLAYER
========================================================= */

.quiz-player{

    max-width:850px;

    margin:40px auto;
}

.quiz-top{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:20px;
}

.quiz-top small{

    color:var(--primary);

    font-weight:900;
}

.quiz-top span{

    font-size:11px;

    color:var(--muted);
}

.quiz-box{

    background:white;

    border:1px solid var(--border);

    border-radius:17px;

    padding:32px;

    box-shadow:var(--shadow);
}

.quiz-box h2{

    font-size:25px;

    margin:20px 0;
}

.question-option{

    display:flex;

    align-items:center;

    gap:12px;

    padding:16px;

    border:1px solid var(--border);

    border-radius:10px;

    margin:10px 0;

    cursor:pointer;

    transition:.2s;
}

.question-option:hover{

    border-color:var(--primary);

    background:#faf9ff;
}

.question-option.selected{

    background:#eeeaff;

    border-color:var(--primary);

    color:var(--primary);

    font-weight:800;
}

.question-option input{

    width:auto;
}

.quiz-footer{

    display:flex;

    justify-content:space-between;

    margin-top:25px;
}


/* =========================================================
   RESULT
========================================================= */

.result{

    max-width:600px;

    margin:70px auto;

    text-align:center;
}

.result-icon{

    width:75px;

    height:75px;

    margin:auto;

    display:grid;

    place-items:center;

    border-radius:50%;

    background:#e8faf2;

    color:var(--success);

    font-size:35px;

    margin-bottom:20px;
}

.result h1{

    font-size:35px;
}

.result p{

    color:var(--muted);

    margin:8px 0;
}

.score{

    width:170px;

    height:170px;

    border-radius:50%;

    margin:30px auto;

    display:grid;

    place-content:center;

    border:14px solid #eeeaff;

    border-top-color:var(--primary);
}

.score strong{

    font-size:38px;
}

.score small{

    color:var(--muted);

    font-size:11px;
}

.result-stats{

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    border-top:1px solid var(--border);

    border-bottom:1px solid var(--border);

    padding:20px;

    margin-bottom:25px;
}

.result-stats b{

    display:block;

    font-size:23px;
}

.result-stats span{

    color:var(--muted);

    font-size:10px;
}


/* =========================================================
   MODAL
========================================================= */

.modal{

    position:fixed;

    inset:0;

    background:rgba(10,13,20,.65);

    display:none;

    align-items:center;

    justify-content:center;

    z-index:200;

    padding:20px;
}

.modal.show{

    display:flex;
}

.modal-box{

    width:100%;

    max-width:430px;

    background:white;

    border-radius:16px;

    padding:28px;

    position:relative;
}

.modal-close{

    position:absolute;

    top:15px;

    right:18px;

    background:none;

    border:0;

    font-size:23px;

    color:#7d8492;
}


/* =========================================================
   FOOTER
========================================================= */

footer{

    background:#171b27;

    color:#aeb4c2;

    padding:35px 6%;

    text-align:center;

    font-size:11px;
}


/* =========================================================
   TOAST
========================================================= */

.toast{

    position:fixed;

    right:25px;

    bottom:25px;

    background:#202633;

    color:white;

    padding:13px 18px;

    border-radius:9px;

    font-size:12px;

    opacity:0;

    transform:translateY(20px);

    pointer-events:none;

    transition:.3s;

    z-index:500;
}

.toast.show{

    opacity:1;

    transform:translateY(0);
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:900px){

    .hero-container{

        grid-template-columns:1fr;

        gap:45px;
    }

    .hero h1{

        font-size:48px;
    }

    .features,
    .quiz-grid{

        grid-template-columns:
        repeat(2,1fr);
    }

    .dashboard-grid{

        grid-template-columns:
        repeat(2,1fr);
    }

    .dashboard-main{

        grid-template-columns:1fr;
    }

}

@media(max-width:650px){

    .navbar{

        padding:0 4%;
    }

    .nav-links{

        display:none;
    }

    .hero{

        padding:70px 0;
    }

    .hero-container{

        width:90%;
    }

    .hero h1{

        font-size:40px;
    }

    .hero-buttons{

        flex-direction:column;
    }

    .features,
    .quiz-grid{

        grid-template-columns:1fr;
    }

    .stats{

        grid-template-columns:
        repeat(2,1fr);

        gap:25px;
    }

    .dashboard-grid{

        grid-template-columns:1fr 1fr;
    }

    .creator-top{

        display:block;
    }

    .quiz-box{

        padding:20px;
    }

    .quiz-footer{

        gap:10px;
    }

    .result-stats{

        grid-template-columns:
        repeat(3,1fr);
    }

}

</style>
</head>


